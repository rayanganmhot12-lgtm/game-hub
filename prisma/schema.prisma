// Prisma schema for Game Hub
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  STEAM
  EPIC
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  accounts          Account[]
  playtimeSnapshots PlaytimeSnapshot[]
  // Mock in-app currency — earned through real usage (syncs, achievements,
  // playtime), spent on cosmetic profile flair. No real money involved.
  points               Int    @default(100)
  lifetimePointsEarned Int    @default(0)
  unlockedCosmetics    String? // JSON array of cosmetic item ids owned
  equippedFrame        String?
  equippedBadge        String?
  // One owned cosmetic "pinned" to show on the profile card, separate from
  // whatever's actually equipped — Discord's "favorite collectible" idea,
  // just pointing at our own Store catalog instead of a real marketplace.
  pinnedCosmeticId     String?
  // Optional override for the display name shown in Friends/Chat/Moderation
  // (falls back to the linked Steam name, then the email prefix, if unset).
  displayName          String?
  // Self-uploaded profile photo, stored as a small resized data URI (client
  // resizes to 256x256 JPEG before upload) — simpler than disk storage for
  // an image this size, and avoids needing a separate file-serving route.
  avatarDataUrl        String?
  bio                  String?
  // Freeform, e.g. "she/her" or "he/they" — shown under the display name on
  // the profile card, next to the custom note below.
  pronouns             String?
  // A short Discord-style custom status line, separate from bio (which is
  // the longer "About Me" block) and separate from the online/idle/dnd
  // presence status in presence.ts.
  profileNote          String?
  // Wide profile banner, same resized-data-URI approach as avatarDataUrl.
  bannerDataUrl        String?
  // A "banner" cosmetic id (animated shimmer/aurora overlay) — same pattern
  // as equippedFrame/equippedBadge.
  equippedBanner       String?
  // Self-only cosmetic, admin account only in practice: an animated
  // two-color gradient effect for the display name. "gradient-cycle" or
  // unset — no other values.
  nameEffect           String?
  // Hex colors for the nameEffect gradient — unset means the CSS default
  // pair. Always set together (see the name-effect API route).
  nameEffectColor1     String?
  nameEffectColor2     String?
  // Plus-exclusive: a custom hex color for this user's profile card border
  // glow, shown to friends viewing their profile.
  accentColor          String?
  // Public, shareable identity for Friends/Chat/Voice — used as the Firebase
  // path segment instead of the internal cuid, so nothing about the local
  // database leaks through the realtime relay.
  friendCode           String?  @unique
  friends              Friend[]
  moderationActions    ModerationAction[]
  chatMessages         ChatMessage[]
  groups               Group[]
  notifications        Notification[]
  missions             MissionProgress[]
}

// One row per mission a user has made progress on. Kept as its own table
// rather than columns on User so adding a mission later is a catalog entry
// (see src/lib/missions.ts) with no migration — the reward itself is read
// from that catalog, never stored here, so re-pricing a mission doesn't
// need a data backfill.
model MissionProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  // Set when the mission's goal is met, cleared only by claiming it.
  completedAt DateTime?
  // Set when the reward has been paid out. Non-null means "never pay again"
  // — this is what makes a one-time mission genuinely one-time.
  claimedAt   DateTime?

  @@unique([userId, missionId])
}

// A persistent local log of one-shot events that would otherwise just be a
// toast and gone — friend requests/accepts, gifts, group invites, warnings,
// announcements — so there's something to show in the notification bell for
// anything that happened while you were away, not just what's still pending.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "friend_request" | "friend_accept" | "group_invite" | "points_gift" | "cosmetic_gift" | "warning" | "announcement"
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Local-only cache of an accepted friendship — each side of a friendship
// stores its own Friend row after a request/accept handshake over Firebase.
// There is no shared "friendship" record anywhere; if this row exists here,
// as far as this installation is concerned, they're friends.
model Friend {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendCode        String
  friendDisplayName String
  // The friend's equipped badge id at the time they were added — purely
  // cosmetic (e.g. a "Developer" tag), captured from their own request/accept
  // payload since there's no live per-friend cosmetic sync.
  friendBadge       String?
  addedAt           DateTime @default(now())

  @@unique([userId, friendCode])
}

// Local cache of the conversation, from this installation's point of view.
// The live "wire" for actually delivering a message is Firebase; once
// delivered, both sides just save their own copy here.
model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  peerFriendCode String
  peerDisplayName String
  direction      String // "sent" | "received"
  text           String
  sentAt         DateTime @default(now())
  // Shared id (generated by the sender, carried through the Firebase relay)
  // so both sides can reference "the same message" for reactions — the local
  // `id` above is only ever unique to this installation's own copy.
  clientId       String?

  @@index([userId, peerFriendCode, sentAt])
}

// Audit trail of moderation actions the admin has taken, kept locally for
// their own reference. The actual live enforcement state (is code X banned
// right now) lives in Firebase at /moderation/{code}, since every client
// needs to check it, not just the admin's own installation.
model ModerationAction {
  id                String    @id @default(cuid())
  adminUserId       String
  admin             User      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  targetCode        String
  targetDisplayName String
  action            String // "warn" | "mute" | "timeout" | "ban" | "unban" | "unmute"
  reason            String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
}

// A local copy of a group this installation's user belongs to. `groupId` is
// a shared, random code (like a friend code) that every member's own
// installation stores — used as the Firebase path segment for group
// chat/voice, so no one's internal cuid ever leaves this database.
model Group {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  name      String
  createdAt DateTime       @default(now())
  members   GroupMember[]
  messages  GroupMessage[]

  @@unique([userId, groupId])
}

// Local cache of who's in the group, from this installation's point of
// view — populated from the invite/member-list relayed over Firebase.
model GroupMember {
  id                String   @id @default(cuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberCode        String
  memberDisplayName String
  memberBadge       String?
  addedAt           DateTime @default(now())

  @@unique([groupId, memberCode])
}

// Local cache of group messages, saved by every member's installation as
// they arrive over the shared Firebase relay.
model GroupMessage {
  id                String   @id @default(cuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderCode        String
  senderDisplayName String
  text              String
  sentAt            DateTime @default(now())
  // Shared id (generated by the sender, carried through the Firebase relay)
  // so every member can reference "the same message" for reactions.
  clientId          String?
  // Which of the server's text channels this belongs to. Null means it
  // predates channels (or the channel was later deleted) — treated as the
  // default "general" channel for display.
  channelId         String?
  // Optional attached image, stored the same way avatars/icons are — a
  // size-capped data URI. No generic file attachments (no file storage
  // backend exists), images only.
  imageDataUrl      String?

  @@index([groupId, sentAt])
}

model Account {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          Platform
  platformAccountId String
  displayName       String
  avatarUrl         String?
  profileUrl        String?
  connectedAt       DateTime    @default(now())
  lastSyncedAt      DateTime?
  ownedGames        OwnedGame[]

  @@unique([platform, platformAccountId])
}

model Game {
  id              String      @id @default(cuid())
  platform        Platform
  platformGameId  String
  title           String
  coverImageUrl   String?
  headerImageUrl  String?
  genres          String? // comma-separated, best-effort
  description     String?
  ownedBy         OwnedGame[]

  @@unique([platform, platformGameId])
}

// Shared, app-wide playlist — every user hears the same tracks. Only the
// admin (ADMIN_EMAIL) can upload or remove tracks; everyone else just plays them.
model Track {
  id         String   @id @default(cuid())
  title      String
  filename   String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())
}

// Recorded on every sync — a running log of the user's grand total playtime
// across all accounts, so a longer-range trend chart can be derived by
// diffing consecutive snapshots (Steam only reports "last 2 weeks" natively).
model PlaytimeSnapshot {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPlaytimeMinutes Int
  capturedAt           DateTime @default(now())

  @@index([userId, capturedAt])
}

model OwnedGame {
  id                  String    @id @default(cuid())
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  gameId              String
  game                Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playtimeMinutes     Int       @default(0)
  playtimeMinutes2Wk  Int       @default(0)
  lastPlayedAt        DateTime?
  installed           Boolean   @default(false)
  rating              Int?
  notes               String?
  // JSON array of achievement apiNames already known to be unlocked, as of
  // the last sync — diffed on each sync to detect newly-unlocked ones.
  unlockedAchievements String?
  // Total achievements available for this game, captured alongside
  // unlockedAchievements — lets cards/the achievements page show "X / Y"
  // without an extra live API call.
  totalAchievements    Int?
  tags                 String? // comma-separated, user-defined (e.g. "co-op,chill")
  backlog              Boolean   @default(false)

  @@unique([accountId, gameId])
}
